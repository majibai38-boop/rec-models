/.worktrees/
/.local-archive/

# Local node declarations and hardware captures
/inventory.local.json
/inventory-results/
/benchmark-results/
/experiments.local.json
/cuda.local.json
/ascend.local.json

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log

# Model and tensor artifacts
*.ckpt
*.onnx
*.pth
*.pt
*.safetensors
