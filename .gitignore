*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments and packaging artifacts
.venv/
venv/
env/
build/
dist/
*.egg-info/
node_modules/
